# Скопируйте файл в .env, ограничьте права и заполните первые два поля.
TELEGRAM_BOT_TOKEN=
OWNER_ID=
# Для Tor выберите socks5 и задайте, например, socks5://127.0.0.1:9050.
TELEGRAM_TRANSPORT=direct
TELEGRAM_PROXY_URL=
# AYAKA_TORRC=~/.config/tor-ayaka/torrc

# Относительный путь отсчитывается от каталога проекта.
DB_PATH=data/ayaka-release.sqlite3
GROUP_RAW_DAYS=14
PRIVATE_RAW_DAYS=30
SUMMARY_DAYS=180
DIARY_TIMEZONE=Europe/Moscow
PER_CHAT_MAX_MESSAGES=10000
DB_MAX_MB=128
CLEANUP_MINUTES=60
MAX_TEXT_CHARS=4000
MAX_MEMORIES=200

# Сетевая Ollama: укажите её достижимый URL. Для WSL NAT см. docs/install-wsl.md.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b-q4_K_M
OLLAMA_NUM_CTX=4096
OLLAMA_MAX_OUTPUT=320
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_HISTORY_LIMIT=16

SPONTANEOUS_ENABLED=true
SPONTANEOUS_COOLDOWN_SECONDS=900
SPONTANEOUS_MIN_MESSAGES=30
SPONTANEOUS_CHANCE_PERCENT=10
GROUP_INITIATIVE_JSON={}
